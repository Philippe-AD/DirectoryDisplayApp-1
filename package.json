{
  "name": "directory-display-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build:electron-main": "tsc -p tsconfig.electron.json",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:preview": "tsc -p tsconfig.electron.json && vite build && electron .",
    "electron:build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "zip": "node zip-project.js",
    "release": "node zip-project.js"
  },
  "build": {
    "appId": "com.directorydisplay.app",
    "productName": "Directory Display App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "mammoth": "^1.12.0",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^26.1.1",
    "@types/prismjs": "^1.26.5",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
